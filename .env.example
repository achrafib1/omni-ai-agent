# ==========================================
# OMNI-AI-AGENT: Environment Variables
# ==========================================

# Copy this file to a private local environment file and replace the example
# values. Never commit real credentials or connection strings.

# --- Application ---
APP_NAME="Omni-AI-Agent"
ENABLE_DEBUG_LOGS="false"
CORS_ORIGINS="http://localhost:8000"
DB_SCHEMA="omni"

# --- AI Models ---
GROQ_API_KEY="example-not-a-real-key"
TOGETHER_API_KEY="example-not-a-real-key"
GEMINI_API_KEY="example-not-a-real-key"

# --- Audio (TTS / STT) ---
ELEVENLABS_API_KEY="example-not-a-real-key"
ELEVENLABS_VOICE_ID="replace-me-locally"

# --- Database & Memory (Supabase) ---
SUPABASE_URL="https://example.invalid"
SUPABASE_SERVICE_KEY="example-not-a-real-key"
POSTGRES_CONNECTION_STRING="postgresql://replace-me-locally"

# --- Integrations (WhatsApp/Meta) ---
WHATSAPP_PHONE_NUMBER_ID="replace-me-locally"
WHATSAPP_TOKEN="example-not-a-real-key"
WHATSAPP_VERIFY_TOKEN="replace-me-locally"

# --- Integrations (Discord) ---
DISCORD_BOT_TOKEN="example-not-a-real-key"

# --- Observability ---
OPIK_API_KEY="example-not-a-real-key"
OPIK_WORKSPACE="replace-me-locally"
OPIK_PROJECT_NAME="omni-ai-agent"
