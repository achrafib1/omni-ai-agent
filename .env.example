# ==========================================
# OMNI-AI-AGENT: Environment Variables
# ==========================================

# --- AI Models ---
GROQ_API_KEY="gsk_your_groq_key_here"
TOGETHER_API_KEY="your_together_key_here"
OPENAI_API_KEY="sk-your_openai_key_here"

# --- Audio (TTS / STT) ---
ELEVENLABS_API_KEY="your_elevenlabs_key_here"
ELEVENLABS_VOICE_ID="your_preferred_voice_id"

# --- Database & Memory (Supabase) ---
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_KEY="your_supabase_service_role_key"
POSTGRES_CONNECTION_STRING="postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres"

# --- Integrations (WhatsApp/Meta) ---
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_TOKEN="your_whatsapp_bearer_token"
WHATSAPP_VERIFY_TOKEN="your_custom_secure_webhook_token"

# --- Observability ---
OPIK_API_KEY="your_opik_api_key"
OPIK_WORKSPACE="your_opik_workspace_name"
OPIK_PROJECT_NAME="omni-ai-agent"